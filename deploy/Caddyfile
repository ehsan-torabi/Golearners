# Dev reverse proxy. The Go API runs on the host (:8080) via `make dev`;
# the Next.js frontend will run on :3000 in later phases.
# Open http://api.localhost/healthz

api.localhost {
	# replace (never append) the forwarded address, and overwrite any
	# client-supplied X-Real-IP: the API resolves the caller's IP from the
	# last trusted hop, so a spoofed header must not survive the proxy
	reverse_proxy host.docker.internal:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

site.localhost {
	reverse_proxy host.docker.internal:3000
}
