# Production reverse proxy: TLS automatic via Let's Encrypt.
{$DOMAIN} {
	encode zstd gzip

	# API (with its security headers set by the app)
	handle /api/* {
		# replace (never append) the forwarded address, and overwrite any
		# client-supplied X-Real-IP: the API resolves the caller's IP from the
		# last trusted hop, so a spoofed header must not survive the proxy
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
	handle /healthz* /readyz* {
		reverse_proxy api:8080
	}

	# Next.js app
	handle {
		reverse_proxy web:3000
	}
}
