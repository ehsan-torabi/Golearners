# GoLearn environment — copy to .env and adjust.
# Everything here is safe dev defaults; NEVER reuse production secrets.

# --- app ---
APP_ENV=development            # development | test | production
APP_BASE_URL=http://localhost:3000
HTTP_PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error

# --- postgres (matches deploy/docker-compose.yml) ---
POSTGRES_USER=golearn
POSTGRES_PASSWORD=golearn
POSTGRES_DB=golearn
DATABASE_URL=postgres://golearn:golearn@localhost:5432/golearn?sslmode=disable

# --- redis ---
REDIS_ADDR=localhost:6379

# --- object storage (MinIO dev defaults; change for prod S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=golearn-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# --- auth (phase 3) ---
# 32+ random bytes; REQUIRED >=32 chars in production.
# dev value: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# --- payments (phase 6, placeholders) ---
PAYMENT_ZARINPAL_MERCHANT_ID=
PAYMENT_ZARINPAL_SANDBOX=true
PAYMENT_DIGIPAY_API_KEY=
PAYMENT_DIGIPAY_SANDBOX=true

# --- vod / sms (phase 5+, placeholders) ---
VOD_PROVIDER=local             # local | arvanvod
SMS_PROVIDER=mock              # mock | kavenegar
